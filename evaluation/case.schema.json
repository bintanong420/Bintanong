{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bintanong-evaluation-case-v1",
  "title": "Evaluation case",
  "description": "Structural schema only. Cross-field rules (status, review independence, route/control/outcome, abstention) live in evaluation/case.py. A schema-valid case is not a verified benchmark case.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "group_id", "category", "language", "query", "adversarial_kinds", "scope", "scope_null_reason", "expected_route", "expected_control", "expected_outcome", "required_facts", "missing_facts", "gold_spans", "gold_rules", "synthetic_policy", "acceptable_claims", "must_abstain", "split", "status", "review"],
  "properties": {
    "schema_version": {"const": "bintanong-evaluation-case-v1"},
    "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "group_id": {"type": "string", "pattern": "^grp-[a-z0-9][a-z0-9-]{2,48}$"},
    "category": {"enum": ["enrollment", "prerequisites", "grades", "academic_standing", "discipline"]},
    "language": {"enum": ["en", "tl", "taglish"]},
    "query": {"type": "string", "minLength": 1},
    "adversarial_kinds": {"type": "array", "items": {"enum": ["ambiguity", "negation", "missing_facts", "wrong_edition", "conflicting_evidence", "unknown_course", "incomplete_coverage", "unsupported_operation", "operational_failure"]}},
    "scope": {"type": ["object", "null"], "additionalProperties": false, "required": ["institution", "edition", "version_id"],
      "properties": {"institution": {"type": "string", "minLength": 1}, "edition": {"type": "string", "minLength": 1}, "version_id": {"type": ["string", "null"], "pattern": "^ver-[a-z0-9][a-z0-9-]*$"}}},
    "scope_null_reason": {"type": ["string", "null"]},
    "expected_route": {"enum": ["RAG", "Hybrid", "Symbolic", null]},
    "expected_control": {"enum": ["clarify", "greeting", "unsupported_scope", "evidence_unavailable", null]},
    "expected_outcome": {"enum": ["eligible", "ineligible", "unknown", "unsupported", "error", null]},
    "required_facts": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "missing_facts": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "gold_spans": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["byte_sha256", "version_id", "page", "locator_ref", "text_sha256"],
      "properties": {"byte_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "version_id": {"type": "string", "pattern": "^ver-[a-z0-9][a-z0-9-]*$"}, "page": {"type": "integer", "minimum": 1}, "locator_ref": {"type": "string", "minLength": 1}, "text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "gold_rules": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "synthetic_policy": {"type": ["string", "null"]},
    "acceptable_claims": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "must_abstain": {"type": "boolean"},
    "split": {"enum": ["dev", "final"]},
    "status": {"enum": ["synthetic", "candidate", "verified"]},
    "review": {"type": "object", "additionalProperties": false, "required": ["author", "reviewer", "evidence_ref", "review_version"],
      "properties": {"author": {"type": ["string", "null"]}, "reviewer": {"type": ["string", "null"]}, "evidence_ref": {"type": ["string", "null"]}, "review_version": {"type": ["string", "null"]}}}
  }
}
